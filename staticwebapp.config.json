{
  "routes": [
    {
      "route": "/",
      "redirect": "/LOCADORA_PAGINA_INICIAL.HTML",
      "statusCode": 302
    },
    {
      "route": "/index.html",
      "redirect": "/LOCADORA_PAGINA_INICIAL.HTML",
      "statusCode": 302
    },
    {
      "route": "/src/*",
      "statusCode": 404
    },
    {
      "route": "/scripts/*",
      "statusCode": 404
    },
    {
      "route": "/database/*",
      "statusCode": 404
    },
    {
      "route": "/test/*",
      "statusCode": 404
    },
    {
      "route": "/node_modules/*",
      "statusCode": 404
    },
    {
      "route": "/.env*",
      "statusCode": 404
    },
    {
      "route": "/.git/*",
      "statusCode": 404
    },
    {
      "route": "/.github/*",
      "statusCode": 404
    },
    {
      "route": "/.integration-backup/*",
      "statusCode": 404
    },
    {
      "route": "/package*.json",
      "statusCode": 404
    },
    {
      "route": "/server.js",
      "statusCode": 404
    }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "no-referrer",
    "X-Frame-Options": "SAMEORIGIN",
    "Content-Security-Policy": "default-src 'self'; script-src 'self'; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
  },
  "mimeTypes": {
    ".JS": "text/javascript",
    ".CSS": "text/css"
  }
}
