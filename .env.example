NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=locadora
DB_USER=central_locadora_app
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=5000

# Chave longa e aleatÃ³ria, usada somente pela ferramenta administrativa de migraÃ§Ã£o.
MIGRATION_ADMIN_KEY=
SESSION_HOURS=8

# Usadas apenas ao executar `npm run create-admin`; nÃ£o mantenha no .env apÃ³s o bootstrap.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_USER=
INITIAL_ADMIN_PASSWORD=

# Gerada por npm run nfse:setup; mantenha protegida e preserve em backup.
NFSE_ENCRYPTION_KEY=
# Opcional: caminho do Python com lxml instalado.
NFSE_PYTHON=python

# Google Drive (OAuth 2.0; configure no Google Cloud Console)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://127.0.0.1:3000/api/drive/oauth/callback
# Chave AES-256-GCM em Base64: gerar com `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
GOOGLE_DRIVE_TOKEN_KEY=
GOOGLE_DRIVE_AUTHORIZED_EMAIL=

